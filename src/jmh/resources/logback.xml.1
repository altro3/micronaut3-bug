<configuration>
    <conversionRule conversionWord="uMDC" converterClass="com.micronaut.bug.log.OrderedMdcLogbackConverter" />

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>/dev/null</file> <!-- Или NUL для Windows -->
        <immediateFlush>false</immediateFlush> <!-- Включаем буферизацию как у Log4j2 -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{15}) - %uMDC - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE" />
        <queueSize>262144</queueSize> <!-- Одинаковый размер очереди -->
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock> <!-- Чтобы не тормозил поток теста при заполнении -->
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC" />
    </root>
</configuration>
