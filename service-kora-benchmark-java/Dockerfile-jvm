FROM bellsoft/liberica-openjdk-debian:25 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends curl wget dos2unix && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY gradle/ /build/gradle/
COPY gradlew /build/gradlew
COPY settings.gradle.kts /build/settings.gradle.kts
COPY build.gradle.kts /build/build.gradle.kts
COPY service-kora-benchmark-java/build.gradle.kts /build/service-kora-benchmark-java/

RUN dos2unix gradlew && chmod +x gradlew

RUN --mount=type=cache,target=/root/.gradle \
    --mount=type=bind,source=.m2-context,target=/root/.m2/repository,ro \
    ./gradlew --no-daemon :service-kora-benchmark-java:dependencies

COPY service-kora-benchmark-java/src /build/service-kora-benchmark-java/src

RUN --mount=type=cache,target=/root/.gradle \
    --mount=type=bind,source=.m2-context,target=/root/.m2/repository,ro \
    ./gradlew --no-daemon :service-kora-benchmark-java:shadowJar

WORKDIR /build/service-kora-benchmark-java/build/libs

FROM bellsoft/liberica-openjre-debian:25

RUN apt-get update && apt-get install -y --no-install-recommends curl wget && rm -rf /var/lib/apt/lists/*

RUN wget -q https://github.com/codesenberg/bombardier/releases/download/v2.0.2/bombardier-linux-amd64 -O /usr/local/bin/bombardier && \
    chmod +x /usr/local/bin/bombardier

WORKDIR /app

COPY --from=builder /build/service-kora-benchmark-java/build/libs/service-kora.jar /app/service-kora.jar

RUN echo '{"userId":1,"userEmail":"a@s.com","promoCode":"123456","items":[{"typeCode":"a","quantity":10}],"tags":["asas","f"]}' > body.json

ENV JVM_OPTS="-Xms16m -Xmx128m -Xss256k -XX:MaxMetaspaceSize=96m -XX:+UseG1GC -XX:+G1PeriodicGCInvokesConcurrent -XX:G1PeriodicGCInterval=3000 -XX:MinHeapFreeRatio=20 -XX:MaxHeapFreeRatio=40 -XX:MaxGCPauseMillis=20 -XX:+UseStringDeduplication -XX:+UnlockExperimentalVMOptions -XX:+UseCompactObjectHeaders -XX:+EliminateAllocations -Dfile.encoding=UTF-8 -Dconfig.override_with_env_vars=true --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.time=ALL-UNNAMED -Djdbc.jdbcUrl=jdbc:postgresql://host.docker.internal:5432/service_kora"

ENV MALLOC_ARENA_MAX=2

EXPOSE 8090
EXPOSE 8085

ENTRYPOINT ["sh", "-c", "java $JVM_OPTS -jar service-kora.jar"]
